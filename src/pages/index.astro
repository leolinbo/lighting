---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ProductFinder from '~/components/ProductFinder.astro';

const metadata = {
  title: 'LED Track Lighting & Downlight Manufacturer | OEM/ODM Factory — ENCORE',
  description:
    'Professional LED track lighting and downlight manufacturer since 2011. OEM/ODM, ETL/CE/ISO certified, factory-direct pricing for distributors and retailers.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Request a Quote',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'View Products',
        href: '#products',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-optics-web-05.jpg',
      alt: 'ENCORE Commercial LED Lighting Solutions',
    }}
  >
    <Fragment slot="title">
      LED <span class="text-accent dark:text-white">Track Lighting</span> &amp; Downlight Manufacturer for OEM/ODM Projects
    </Fragment>
    <Fragment slot="subtitle">
      ENCORE is dedicated to researching, developing and manufacturing high quality LED luminaires and providing premium
      LED lighting solutions for commercial spaces, hotels, museums, galleries and offices.
      <span class="block mt-2 font-semibold">ETL / CE / ISO certified &middot; OEM &amp; ODM &middot; Since 2011</span>
    </Fragment>
  </Hero>

  <!-- SEO Intro Copy -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <div class="prose prose-lg mx-auto max-w-4xl dark:prose-invert">
      <p class="text-lg leading-relaxed text-muted dark:text-slate-300">
        ENCORE is a professional <strong>LED track lighting manufacturer</strong> and downlight factory based in Shenzhen,
        China, serving B2B buyers since 2011. We produce high-output <a href="/products/track-lighting"
          >LED track lighting systems</a
        > — VEGA, OVEGA, IMAX and FLEX — plus <a href="/products/led-downlights">LED downlights</a>, magnetic track
        lights and linear luminaires for retail, hospitality, museums and offices. Every fixture is built in our
        ISO9001-certified factory with ETL, CE and SAA options for North American, European and Australian projects.
      </p>
      <p class="text-lg leading-relaxed text-muted dark:text-slate-300">
        Looking for a partner behind your private label? Our <a href="/oem-odm"
          >OEM LED lighting and ODM manufacturing</a
        > services cover custom housings, CCT, CRI, beam angle, dimming and branded packaging, with factory-direct pricing
        and 5-year warranty. <a href="/contact">Request a quote</a> for your project today.
      </p>
    </div>
  </section>

  <!-- Why Choose ENCORE -->
  <Features
    id="why-us"
    tagline="Why Choose ENCORE"
    title="LED Lighting Manufacturer You Can Trust"
    subtitle="With over a decade of expertise, we deliver premium LED lighting solutions for B2B partners across 85+ countries worldwide."
    items={[
      {
        title: 'ETL / CE / ISO / SAA Certified',
        description:
          'All products meet rigorous international safety and quality standards. Full certification documentation available upon request for every shipment.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'OEM & ODM Manufacturing',
        description:
          'Custom designs, branding, packaging, and specifications tailored to your market. R&D team covering industrial design, optics, thermal, electronics, and structure.',
        icon: 'tabler:settings',
      },
      {
        title: 'In-House Factory Since 2014',
        description:
          '2/F, Bldg 8th, Zhengzhong Industrial Park, Fuyong, Shenzhen. Full control over production, quality, and supply chain. ERP system for end-to-end traceability.',
        icon: 'tabler:building',
      },
      {
        title: 'Stringent Quality Control',
        description:
          'IQC incoming inspection &rarr; IPQC process control &rarr; 100% aging test &rarr; OQC final inspection. ISO9001:2018 certified quality management system.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Global Reach',
        description:
          'Products exported to 85+ countries across North America, Europe, Australia, Southeast Asia, Middle East and Latin America. HK HQ + Shenzhen factory.',
        icon: 'tabler:world',
      },
      {
        title: 'R&D Innovation',
        description:
          'High-tech enterprise with multiple patents. Advanced R&D lab with photoelectric, safety reliability, and EMC testing capabilities. 9 product families and growing.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Products Showcase -->
  <Content
    id="products"
    isReversed
    isAfterContent
    tagline="Our Products"
    title="Complete LED Lighting Product Families"
    subtitle="9 product families covering every commercial lighting application"
    items={[
      {
        title: 'Track Lighting Systems',
        description:
          'VEGA, OVEGA, IMAX, FLEX track light systems. Multiple beam angles, wattages, and color temperatures. Suitable for retail, museums, galleries, and hospitality.',
      },
      {
        title: 'LED Downlights',
        description:
          'DELLA Mini, ELLA, Galaxy, AVA MR16 downlight systems. Modular designs, tunable white options, smart dimming. From 2-inch mini downlights to high-ceiling 4-8m solutions.',
      },
      {
        title: 'Linear & Cylinder Lighting',
        description:
          'Linear Light System and Cylinder Light System for modern architectural lighting. Clean aesthetics, high performance, flexible installation.',
      },
      {
        title: 'Specialty Lighting',
        description:
          'Magnetic Track Lights, Motorized Remote Controlled Lighting, ETL Downlights, Wall Luminaires. Custom solutions for unique project requirements.',
      },
      {
        title: 'Compare Series',
        description:
          'Side-by-side comparison of VEGA, OVEGA, IMAX, FLEX, magnetic and downlight systems — wattage, beam angle, CRI and dimming at a glance.',
        callToAction: {
          variant: 'link',
          text: 'Open comparison →',
          href: getPermalink('/products/compare'),
        },
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-cutlight-web-01.jpg',
      alt: 'ENCORE LED Track Lighting Products',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        9 Product Families &amp; Growing
      </h3>
      From design to delivery — comprehensive LED lighting solutions for every commercial space.
    </Fragment>
  </Content>

  <!-- Factory & Quality -->
  <Content
    isAfterContent
    tagline="Factory & Quality"
    title="In-House Manufacturing Excellence"
    subtitle="Since 2014, our Shenzhen factory has been the backbone of ENCORE quality"
    items={[
      {
        title: 'Modern Production Facility',
        description:
          '2/F Bldg 8th, Zhengzhong Industrial Park, Fuyong, Shenzhen. Equipped with professional SMT lines, assembly workstations, and aging test rooms for mass production.',
      },
      {
        title: 'Quality Control Process',
        description:
          'IQC: Incoming material inspection per AQL standard &rarr; IPQC: In-process inspection &rarr; 100% aging test &rarr; OQC: Final function and electrical testing. Full traceability with tracking codes.',
      },
      {
        title: 'R&D Laboratory',
        description:
          'Professional R&D lab with integrating sphere, IES testing, temperature and waterproof testing, IK/fire class testing, EMC testing. Photoelectric, safety, and reliability verification.',
      },
      {
        title: 'Showroom & Warehouse',
        description:
          '900 sqm showroom displaying all product families. 2000 sqm warehouse with inventory management system for efficient order fulfillment.',
      },
    ]}
    image={{
      src: '~/assets/images/factory/fac-newfactory-web-01.jpg',
      alt: 'ENCORE Factory and Production Facility',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Quality Built In, Every Step of the Way
      </h3>
      ISO9001:2018 certified production processes ensure consistent quality across every order.
    </Fragment>
  </Content>

  <!-- Certifications -->
  <Content
    isReversed
    isAfterContent
    tagline="Certifications"
    title="Global Certifications for Global Markets"
    subtitle="Full compliance with international safety and quality standards"
    items={[
      {
        title: 'ETL Certification',
        description:
          'Products certified for North American market. Meets UL standards for safety and performance in the USA and Canada.',
      },
      {
        title: 'CE Certification',
        description:
          'LVD and EMC directives compliance for European market. Full range of track lights and downlights CE certified.',
      },
      {
        title: 'SAA Certification',
        description: 'AIMER, AXIS, FLEX, IMAX, and OVEGA series SAA certified for Australian and New Zealand markets.',
      },
      {
        title: 'ISO9001:2018 & High-Tech',
        description:
          'ISO9001:2018 certified quality management system. Recognized as a High-Technology Enterprise with multiple design and utility model patents.',
      },
    ]}
    image={{
      src: '~/assets/images/certifications/ETL_Certificate.jpg',
      alt: 'ENCORE ETL Certification',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        40+ Certification Documents Available
      </h3>
      ETL &middot; CE (LVD+EMC) &middot; SAA &middot; ISO9001:2018 &middot; Patents
    </Fragment>
  </Content>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Years in Industry', amount: '15+' },
      { title: 'Product Families', amount: '9' },
      { title: 'Export Countries', amount: '85+' },
      { title: 'Global Projects', amount: '1000+' },
    ]}
  />

  <!-- Company Journey -->
  <Content
    isAfterContent
    tagline="Our Journey"
    title="From 2011 to Today — A Story of Growth"
    subtitle="Key milestones that shaped ENCORE into a trusted lighting manufacturer"
    items={[
      {
        title: '2011 — 2013: Foundation',
        description:
          'Founded in 2011 as a foreign trading company focused on LED commercial lighting. Built our own R&D team in 2013 and released the first self-developed LED track light — Aimer.',
      },
      {
        title: '2014 — 2017: Factory & Expansion',
        description:
          'Established our own factory in 2014. Released 11 track light and 3 downlight families by 2016. Expanded to a larger facility with professional equipment in 2017.',
      },
      {
        title: '2018 — 2020: Innovation & Recognition',
        description:
          'High-tech enterprise certification with multiple patents. ERP system and ISO9001:2018 upgrade. Launched ELLA modular downlight system in 2020.',
      },
      {
        title: '2021 — Today: Global Growth',
        description:
          'Galaxy downlight system for high ceilings. Brand upgrade and FEILITE sub-brand launch. Serving 85+ countries with comprehensive product families.',
      },
    ]}
    image={{
      src: '~/assets/images/factory/fac-showroom-web-01.jpg',
      alt: 'ENCORE Showroom',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        15+ Years of Lighting Excellence
      </h3>
      From a trading company to a global lighting manufacturer — built on innovation, quality, and trust.
    </Fragment>
  </Content>

  <!-- Lighting Tools Showcase -->
  <Features2
    tagline="Lighting Tools"
    title="Free Lighting Design Tools"
    subtitle="Work out beam spread, lux levels, fixture counts and color temperature before you ask for a quote."
    columns={3}
    items={[
      {
        title: 'Beam Angle Calculator',
        description: 'Convert beam angle, mounting distance and beam diameter. Find the spot size at any height.',
        icon: 'tabler:angle',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/beam-angle-calculator'),
        },
      },
      {
        title: 'Lux Calculator',
        description: 'How many lumens and fixtures does your space need? Target lux by application with a grid layout.',
        icon: 'tabler:bulb',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/tools/lux-calculator'),
        },
      },
      {
        title: 'Fixture Count Calculator',
        description: 'Estimate how many LED track lights or downlights per room, with recommended spacing and layout.',
        icon: 'tabler:grid-dots',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/tools/fixture-count-estimator'),
        },
      },
      {
        title: 'Color Temperature Guide',
        description: 'Compare 2700K to 6500K side by side and pick the right CCT for retail, office or hospitality.',
        icon: 'tabler:palette',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/tools/cct-guide'),
        },
      },
      {
        title: 'CRI Guide',
        description: 'What does CRI 80 vs 90 vs 95 look like? Interactive comparison and specification guidance.',
        icon: 'tabler:droplet',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/tools/cri-guide'),
        },
      },
      {
        title: 'Unit Converter',
        description: 'Convert m/ft, m²/ft², lux/foot-candles and W/VA for spec sheets and datasheets.',
        icon: 'tabler:arrows-exchange',
        callToAction: {
          variant: 'link',
          text: 'Open tool →',
          href: getPermalink('/tools/unit-converter'),
        },
      },
    ]}
  />

  <!-- Product Finder -->
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6 lg:py-16">
    <ProductFinder />
  </section>

  <!-- BlogLatestPosts Widget -->
  <BlogLatestPosts
    title="Latest from ENCORE Blog"
    information="Lighting industry insights, product guides, and company updates."
  />

  <!-- FAQs Widget -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Common questions about working with ENCORE as your lighting manufacturing partner."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'How many fixtures do I need for my space?',
        description:
          'Use our free <a href="/tools/lux-calculator">lux calculator</a> and <a href="/tools/fixture-count-estimator">fixture count calculator</a> to estimate required lumens and fixture quantity from your room size and target illuminance.',
      },
      {
        title: 'What certifications do your products have?',
        description:
          'Our products are certified with ETL (North America), CE (Europe), SAA (Australia/New Zealand), and ISO9001:2018 (Quality Management). We also hold multiple design and utility model patents. Contact us for specific certification documents for your target market.',
      },
      {
        title: 'Can you customize products with my brand?',
        description:
          'Absolutely. We offer full OEM and ODM services including custom housing colors, logo printing, branded packaging, custom wattages, color temperatures, and private label solutions. Our R&D team works with you to create the perfect product for your market.',
      },
      {
        title: 'What is your MOQ and lead time?',
        description:
          'Standard MOQ is 500 units per model for OEM orders, with flexible options for trial orders. Sample lead time: 7-15 days. Bulk production: 25-45 days depending on quantity and customization level.',
      },
      {
        title: 'Do you offer warranty on your products?',
        description:
          'Yes, we offer a comprehensive 5-year warranty on all LED lighting products. Our after-sales team provides prompt support for any quality concerns within the warranty period.',
      },
      {
        title: 'How do I choose the right beam angle for my project?',
        description:
          'It depends on your mounting height and the area you want to cover. Use our free <a href="/beam-angle-calculator">beam angle calculator</a> to compute the beam spread at your distance, or contact our engineers for a recommendation tailored to your application.',
      },
      {
        title: 'What markets do you serve?',
        description:
          'We export to over 85 countries across North America, Europe, Australia, Southeast Asia, Middle East, and Latin America. Our HK HQ handles global logistics while our Shenzhen factory manages production.',
      },
      {
        title: 'How do I request a quote?',
        description:
          'Contact our sales team via email at sales@encore-tech.com, WhatsApp at +852 6768 2519, or use the contact form on our website. We typically respond within 24 hours with detailed pricing and product information.',
      },
    ]}
  />

  <!-- CallToAction -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request a Quote',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Email Us',
        href: 'mailto:sales@encore-tech.com',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Partner with <span class="sm:whitespace-nowrap">ENCORE</span>?
    </Fragment>
    <Fragment slot="subtitle">
      Get in touch with our team for product information, pricing, or custom manufacturing inquiries.
      <br class="hidden md:inline" /> Email: sales@encore-tech.com | Tel: +852 6768 2519
    </Fragment>
  </CallToAction>
</Layout>
