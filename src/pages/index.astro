---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Rock Wong — Founder of ENCORE',
  description: 'The story, philosophy and work of Rock Wong, founder of ENCORE — a Shenzhen lighting manufacturer built around better light, better engineering and long-term partnerships.',
  ignoreTitleTemplate: true,
};

const milestones = [
  ['2011', 'ENCORE begins', 'A lighting business starts with a simple belief: good products come from people who understand the people using them.'],
  ['2013', 'R&D becomes the core', 'The first self-developed commercial lighting products turn field experience into engineering.'],
  ['2014', 'A factory of our own', 'ENCORE moves closer to the work — controlling design, production and quality under one roof.'],
  ['Today', 'Still close to the light', 'From museums and galleries to hotels and retail spaces, the work remains practical: make the light right.'],
];

const principles = [
  ['01', 'Stay close to the product', 'A specification sheet is never the whole story. Materials, heat, optics, movement and assembly matter.'],
  ['02', 'Make communication shorter', 'When a designer can speak directly with an engineer, problems get solved before they become expensive.'],
  ['03', 'Build for the second order', 'The best relationship is not the first shipment. It is the project that comes back years later.'],
];

const fields = [
  ['Light', 'Optics, beam control, colour, glare and the quiet details that change a room.'],
  ['Making', 'A Shenzhen factory where ideas can move quickly from drawing to prototype to production.'],
  ['People', 'Designers, architects, distributors and engineers working as one team instead of four layers.'],
];
---
<PageLayout metadata={metadata}>
  <main class="founder-site">
    <section class="founder-hero" id="top">
      <div class="hero-orbit hero-orbit-a"></div><div class="hero-orbit hero-orbit-b"></div><div class="hero-grid"></div>
      <div class="hero-copy">
        <p class="eyebrow">ENCORE / THE FOUNDER</p>
        <h1>Light is not<br /><em>the product.</em><br />It is the reason.</h1>
        <p class="hero-intro">The story of <strong>Rock Wong</strong> and the company he built around a simple idea: good lighting begins long before the switch is turned on.</p>
        <a class="text-link" href="#story">Enter the story <span>↓</span></a>
      </div>
      <div class="hero-side"><span>SHENZHEN · CHINA</span><span>2011 — PRESENT</span></div><div class="hero-mark">E</div>
    </section>

    <section class="statement" id="story">
      <div class="section-index">01 / THE BEGINNING</div>
      <div class="statement-copy">
        <p class="kicker">Before ENCORE was a factory, it was a question.</p>
        <h2>What if a lighting manufacturer could think like a designer?</h2>
        <p>Rock Wong founded ENCORE in 2011 and spent the years that followed moving closer to the actual work: understanding how light behaves, how fixtures are built, where products fail, and what designers need when a project leaves the drawing board.</p>
        <p>The answer was not another catalogue. It was a different way of working — closer engineering, tighter feedback and a factory that could take responsibility for the final result.</p>
      </div>
    </section>

    <section class="image-break">
      <div class="image-frame"><img src="/_astro/fac-newfactory-web-01.jpg" alt="ENCORE factory in Shenzhen" loading="lazy" /><span>THE FACTORY / SHENZHEN</span></div>
      <div class="image-caption"><span>02</span><p>Move closer to the work.</p></div>
    </section>

    <section class="timeline-section">
      <div class="section-index">02 / THE JOURNEY</div>
      <div class="timeline">{milestones.map(([year,title,copy],i)=><article class:list={['timeline-item',{'timeline-item-last':i===milestones.length-1}]}><div class="timeline-year">{year}</div><div class="timeline-line"><span></span></div><div class="timeline-content"><h3>{title}</h3><p>{copy}</p></div></article>)}</div>
    </section>

    <section class="dark-manifesto" id="philosophy">
      <div class="section-index">03 / THE WAY OF WORKING</div>
      <div class="manifesto-heading"><p class="kicker">No theatre. Just the work.</p><h2>Good manufacturing is invisible.<br /><em>You notice it when it is missing.</em></h2></div>
      <div class="principles">{principles.map(([number,title,copy])=><article class="principle"><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
    </section>

    <section class="field-section">
      <div class="section-index">04 / WHAT WE CARE ABOUT</div>
      <div class="field-layout"><div class="field-heading"><p class="kicker">The work is bigger than a fixture.</p><h2>Three things stay<br /><em>at the centre.</em></h2></div><div class="fields">{fields.map(([title,copy])=><article class="field-card"><div class="field-number"></div><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div>
    </section>

    <section class="portrait-section">
      <div class="portrait-copy"><p class="eyebrow">THE PERSON BEHIND ENCORE</p><h2>Rock Wong</h2><p class="role">Founder · ENCORE</p><p>A manufacturer by practice, an engineer at heart, and a believer in keeping the distance between a good idea and a good product as short as possible.</p></div>
      <div class="portrait-placeholder"><div class="portrait-letter">R</div><span>PORTRAIT / COMING SOON</span></div>
    </section>

    <section class="closing"><div class="closing-number">2011—∞</div><div><p class="eyebrow">THE NEXT CHAPTER</p><h2>Keep making light<br /><em>worth noticing.</em></h2><p class="closing-copy">ENCORE continues to grow from the same place it started: close to the product, close to the people, and close to the spaces that depend on good light.</p><div class="closing-actions"><a class="button-light" href="https://www.encore-tech.com/" target="_blank" rel="noreferrer">Visit ENCORE</a><a class="text-link light-link" href="mailto:sales@encore-tech.com">Start a conversation <span>↗</span></a></div></div></section>

    <footer class="founder-footer"><span>ENCORE / FOUNDER</span><span>SHENZHEN · HONG KONG</span><a href="#top">BACK TO TOP ↑</a></footer>
  </main>
  <style>
    .founder-site{--ink:#111;--paper:#f2f0eb;--warm:#c8a56a;--line:rgba(17,17,17,.14);background:var(--paper);color:var(--ink);overflow:hidden}
    .founder-hero{min-height:calc(100svh - 72px);position:relative;display:grid;align-items:end;padding:clamp(5rem,11vw,9rem) clamp(1.5rem,6vw,7rem);background:#111;color:#f5f3ee;isolation:isolate}
    .hero-grid{position:absolute;inset:0;z-index:-2;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(to bottom,black,transparent 92%)}
    .hero-orbit{position:absolute;border:1px solid rgba(255,255,255,.16);border-radius:999px;z-index:-1}.hero-orbit-a{width:72vw;height:72vw;right:-27vw;top:-16vw}.hero-orbit-b{width:42vw;height:42vw;right:-11vw;top:-1vw;border-color:rgba(200,165,106,.35)}
    .hero-copy{max-width:980px}.eyebrow,.kicker,.section-index,.hero-side,.image-frame span,.portrait-placeholder span,.founder-footer{font-size:.68rem;letter-spacing:.18em;text-transform:uppercase}.eyebrow{color:var(--warm);margin-bottom:1.5rem}
    .founder-hero h1{margin:0;font-size:clamp(4.3rem,10vw,10.5rem);line-height:.82;letter-spacing:-.07em;font-weight:500}.founder-hero h1 em,h2 em{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.05em}
    .hero-intro{max-width:530px;margin:3rem 0 2rem;font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.55;color:rgba(245,243,238,.72)}.text-link{display:inline-flex;gap:.8rem;align-items:center;color:inherit;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.35rem;font-size:.8rem;letter-spacing:.04em}.text-link span{transition:transform .25s ease}.text-link:hover span{transform:translateY(3px)}
    .hero-side{position:absolute;right:clamp(1.5rem,4vw,4rem);top:50%;transform:rotate(90deg) translateX(50%);transform-origin:right center;color:rgba(255,255,255,.45);display:flex;gap:2rem}.hero-mark{position:absolute;right:clamp(1.5rem,6vw,7rem);bottom:clamp(1.5rem,5vw,4rem);font-size:2.2rem;font-weight:700}
    .statement,.timeline-section,.field-section{max-width:1320px;margin:0 auto;padding:clamp(6rem,12vw,12rem) clamp(1.5rem,5vw,4rem)}.section-index{color:#777;margin-bottom:clamp(3rem,7vw,7rem)}
    .statement-copy{max-width:930px;margin-left:17%}.kicker{color:#777;margin-bottom:1.5rem}h2{font-size:clamp(3rem,6.5vw,7rem);line-height:.91;letter-spacing:-.065em;font-weight:500;margin:0}.statement-copy>p:not(.kicker){max-width:650px;font-size:1.05rem;line-height:1.8;color:#555;margin-top:2.2rem}
    .image-break{max-width:1320px;margin:0 auto;padding:0 clamp(1.5rem,5vw,4rem) clamp(6rem,12vw,12rem);display:grid;grid-template-columns:1fr 180px;gap:2rem;align-items:end}.image-frame{position:relative;overflow:hidden;background:#ddd}.image-frame img{display:block;width:100%;height:min(72vh,760px);object-fit:cover;filter:grayscale(100%);transition:transform 1s cubic-bezier(.2,.7,.2,1),filter .8s ease}.image-frame:hover img{transform:scale(1.025);filter:grayscale(0)}.image-frame span{position:absolute;bottom:1.2rem;left:1.2rem;color:white;text-shadow:0 1px 8px rgba(0,0,0,.4)}.image-caption{padding-bottom:1rem}.image-caption span{font-family:Georgia,serif;font-size:3rem;color:var(--warm)}.image-caption p{font-size:.9rem;line-height:1.4}
    .timeline{border-top:1px solid var(--line)}.timeline-item{display:grid;grid-template-columns:150px 28px minmax(0,560px);gap:2rem;padding:3rem 0;border-bottom:1px solid var(--line)}.timeline-year{font-size:.8rem;letter-spacing:.08em;color:#777}.timeline-line{position:relative}.timeline-line:before{content:'';position:absolute;top:.3rem;left:9px;width:8px;height:8px;border-radius:50%;background:var(--warm)}.timeline-line:after{content:'';position:absolute;top:1rem;bottom:-3rem;left:13px;width:1px;background:var(--line)}.timeline-item-last .timeline-line:after{display:none}.timeline-content h3,.principle h3,.field-card h3{font-size:1.35rem;margin:0 0 .8rem;font-weight:500;letter-spacing:-.03em}.timeline-content p,.principle p,.field-card p{color:#666;line-height:1.65;margin:0}
    .dark-manifesto{background:#111;color:#f3f1ec;padding:clamp(6rem,12vw,12rem) clamp(1.5rem,6vw,7rem)}.dark-manifesto .section-index{color:rgba(255,255,255,.4)}.manifesto-heading{max-width:1000px;margin:0 auto 8rem}.manifesto-heading .kicker{color:var(--warm)}.principles{max-width:1000px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:3rem}.principle{border-top:1px solid rgba(255,255,255,.2);padding-top:1.2rem}.principle>span{color:var(--warm);font-family:Georgia,serif;font-size:1.2rem}.principle h3{margin-top:3rem}.principle p{color:rgba(255,255,255,.55)}
    .field-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:10%;align-items:start}.fields{border-top:1px solid var(--line)}.field-card{display:grid;grid-template-columns:50px 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid var(--line)}.field-number{width:7px;height:7px;border-radius:50%;background:var(--warm);margin-top:.6rem}
    .portrait-section{display:grid;grid-template-columns:1fr 1fr;min-height:80vh;background:#ddd}.portrait-copy{padding:clamp(4rem,8vw,8rem);display:flex;flex-direction:column;justify-content:center;background:#e7e3db}.portrait-copy h2{font-size:clamp(4rem,7vw,7rem)}.portrait-copy .role{color:#777;margin:.8rem 0 2rem;font-size:.85rem;letter-spacing:.12em;text-transform:uppercase}.portrait-copy>p:last-child{max-width:430px;line-height:1.7;color:#555}.portrait-placeholder{min-height:600px;background:#c9c6bf;display:grid;place-items:center;position:relative}.portrait-letter{font-size:min(30vw,22rem);line-height:.7;color:rgba(17,17,17,.14);font-weight:600;letter-spacing:-.1em}.portrait-placeholder span{position:absolute;bottom:1.5rem;left:1.5rem;color:rgba(17,17,17,.5)}
    .closing{background:#bba06e;color:#111;padding:clamp(6rem,12vw,12rem) clamp(1.5rem,8vw,9rem);display:grid;grid-template-columns:1fr 2fr;gap:5%}.closing-number{font-family:Georgia,serif;font-size:clamp(2rem,5vw,5rem);color:rgba(17,17,17,.5)}.closing .eyebrow{color:#111}.closing h2{font-size:clamp(3.5rem,7vw,8rem)}.closing-copy{max-width:570px;margin:2rem 0;line-height:1.7;color:rgba(17,17,17,.7)}.closing-actions{display:flex;gap:2rem;align-items:center;flex-wrap:wrap}.button-light{display:inline-flex;padding:.9rem 1.4rem;background:#111;color:white;text-decoration:none;border-radius:999px;font-size:.8rem}.light-link{color:#111}
    .founder-footer{display:flex;justify-content:space-between;gap:1rem;padding:1.4rem clamp(1.5rem,5vw,4rem);background:#111;color:rgba(255,255,255,.5)}.founder-footer a{color:inherit;text-decoration:none}
    @media(max-width:800px){.hero-side{display:none}.statement-copy{margin-left:0}.image-break{grid-template-columns:1fr}.image-frame img{height:60vh}.timeline-item{grid-template-columns:75px 20px 1fr;gap:1rem}.principles,.field-layout,.portrait-section,.closing{grid-template-columns:1fr}.manifesto-heading{margin-bottom:4rem}.portrait-placeholder{min-height:70vw}.founder-footer{flex-direction:column}}
  </style>
</PageLayout>