---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink, getHomePermalink, getBlogPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

// Build FAQPage structured data from the post body when it contains a visible FAQ section.
// Every question/answer pair must exist in the rendered HTML (extracted from the same source),
// satisfying the Google requirement that FAQ content is visible on the page.
const faqSchema =
  post.faqs && post.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

// Article structured data — pairs with the page's visible metadata so Google can
// surface it as a rich article result (headline, author, publisher, dates, image).
const homeUrl = getCanonical(getHomePermalink());
const blogUrl = getCanonical(getBlogPermalink());
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  ...(image ? { image: typeof image === 'string' ? image : new URL(image.src, Astro.site ?? '').toString() } : {}),
  author: { '@type': 'Organization', name: post.author || 'ENCORE' },
  publisher: {
    '@type': 'Organization',
    name: 'ENCORE',
    url: homeUrl,
  },
  datePublished: post.publishDate.toISOString(),
  ...(post.updateDate ? { dateModified: post.updateDate.toISOString() } : {}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  ...(post.tags && post.tags.length > 0 ? { keywords: post.tags.map((t) => t.title).join(', ') } : {}),
};

// BreadcrumbList structured data: Home > Blog > [Category] > Post title.
const breadcrumbList = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
  { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
  ...(post.category
    ? [
        {
          '@type': 'ListItem',
          position: 3,
          name: post.category.title,
          item: getCanonical(getPermalink(post.category.slug, 'category')),
        },
      ]
    : []),
  { '@type': 'ListItem', position: post.category ? 4 : 3, name: post.title, item: url },
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbList,
};
---

<Layout metadata={metadata}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  <SinglePost post={{ ...post, image: image }} url={url}>
    {typeof post.Content === 'string' ? <Fragment set:html={post.Content} /> : post.Content && <post.Content />}
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
