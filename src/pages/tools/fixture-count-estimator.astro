---
/**
 * Fixture Count Estimator — extended lux calculator focused on fixture
 * quantity and layout for a rectangular room.
 */

import LuxCalculator from '~/components/LuxCalculator.astro';
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import RelatedTools from '~/components/RelatedTools.astro';
import { getPermalink, getCanonical } from '~/utils/permalinks';

const metadata = {
  title: 'Light Fixture Count Calculator — How Many Lights Per Room?',
  description:
    'Estimate how many LED track lights or downlights you need per room. Enter room size, target lux and fixture wattage to get fixture count and a recommended grid layout.',
  canonical: String(getCanonical(getPermalink('/tools/fixture-count-estimator'))),
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I calculate how many light fixtures I need for a room?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Multiply the target lux by the floor area in square metres to get required lumens, divide by the lumen output of one fixture (wattage × lm/W), and round up. Our fixture count calculator does this automatically.',
      },
    },
    {
      '@type': 'Question',
      name: 'What spacing should I use between LED track lights?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A good starting point is spacing fixtures at 1.0–1.5 times the mounting height for flood beams, and closer for narrow spot beams. Our calculator suggests a grid layout based on your room dimensions and fixture count.',
      },
    },
    {
      '@type': 'Question',
      name: 'How many recessed downlights do I need for a living room?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For a typical 20 m² living room, choose the target illuminance and the actual lumen output first. A 10W LED downlight at roughly 1100 lm may need about 6–12 fittings when typical utilisation and maintenance allowances are included. Use the calculator for a project-specific estimate.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far apart should LED track lights be?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start from the beam diameter at the work plane, not a single fixed distance. Flood beams usually need 20–30% overlap for uniform light, while narrow accent beams can be spaced around display positions. Check the spot diameter with the Beam Angle Calculator, then validate the arrangement with the fixture count grid.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />

  <!-- Hero -->
  <section
    class="relative not-prose bg-gradient-to-b from-blue-50/60 to-transparent py-14 dark:from-slate-900/40 md:py-20"
  >
    <div class="mx-auto max-w-4xl px-4 text-center">
      <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Lighting Design Tool</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tighter font-heading dark:text-white md:text-5xl">
        Light Fixture Count Calculator
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted dark:text-slate-300">
        How many LED track lights or downlights do you need per room? Enter your room size, target illuminance and
        fixture wattage to get the exact fixture count and a suggested grid layout.
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <section class="mx-auto max-w-6xl px-4 pb-6 md:px-6">
    <LuxCalculator idPrefix="fx" />
  </section>

  <!-- Guide -->
  <section class="mx-auto max-w-6xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">Spacing & Layout Rules of Thumb</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <h3 class="text-base font-bold dark:text-white">1. Spacing vs. mounting height</h3>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            For flood beams (36°+), space fixtures at 1.0–1.5× the mounting height. For spot beams (10°–24°), reduce
            spacing to 0.5–1.0× to avoid dark pools between fixtures.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <h3 class="text-base font-bold dark:text-white">2. Aim for uniformity</h3>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            The beam diameter at the work plane should overlap its neighbour by about 20–30% for even illumination. Use
            the beam angle calculator to check the spot size at your mounting height.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <h3 class="text-base font-bold dark:text-white">3. Perimeter rule</h3>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            Keep the outer row of fixtures about half a spacing distance from the walls — this lights the walls without
            creating harsh shadows, and improves the perceived brightness of the room.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Room examples -->
  <section class="mx-auto max-w-6xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">How Many Lights Per Room? Start With the Task</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        Fixture quantity is not just a room-size question. The same 20 m² space can need a different number of lights for
        relaxed hospitality lighting, retail display lighting or a focused work plane. Use the calculator result as a
        first grid, then check the beam overlap and photometric distribution before purchase.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[680px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-slate-700">
              <th class="py-3 pr-4 font-semibold">Room or task</th>
              <th class="py-3 pr-4 font-semibold">Typical target</th>
              <th class="py-3 pr-4 font-semibold">Planning question</th>
              <th class="py-3 font-semibold">Next check</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
            <tr>
              <td class="py-3 pr-4 font-medium">20 m² living room</td>
              <td class="py-3 pr-4">150–300 lux</td>
              <td class="py-3 pr-4">How many downlights create comfortable ambient light?</td>
              <td class="py-3">Set the lumen output per fitting and check glare at seating positions.</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">50 m² retail floor</td>
              <td class="py-3 pr-4">300–750 lux</td>
              <td class="py-3 pr-4">How many track lights provide general and accent light?</td>
              <td class="py-3">Use a separate beam and higher-CRI check for display accents.</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">100 m² office</td>
              <td class="py-3 pr-4">300–500 lux</td>
              <td class="py-3 pr-4">How many fixtures meet the desk-plane target?</td>
              <td class="py-3">Confirm UGR, workstation layout and uniformity in the photometric plan.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted dark:text-slate-400">
        Use the <a class="font-medium text-primary underline" href={getPermalink('/beam-angle-calculator')}>Beam Angle Calculator</a>
        to calculate the spot diameter at your mounting height, then review the <a class="font-medium text-primary underline" href={getPermalink('/tools/photometric-guide')}>Photometric Data Guide</a>
        before finalising the grid.
      </p>
    </div>
  </section>

  <!-- FAQs -->
  <FAQs
    tagline="FAQs"
    title="Fixture Quantity Questions"
    subtitle="Common questions about how many lights a room needs."
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'How do I calculate how many light fixtures I need?',
        description:
          'Start with target lux × floor area, divide by the combined utilisation and maintenance factor, then divide by the lumen output of one fixture (wattage × efficacy) and round up. The calculator above does it for you.',
      },
      {
        title: 'What spacing should I use between LED track lights?',
        description:
          'Start with 1.0–1.5× the mounting height for flood beams and closer for spots. Our calculator suggests a grid from your room size and fixture count.',
      },
      {
        title: 'How many downlights do I need for a living room?',
        description:
          'For a typical 20 m² living room, choose the target illuminance and actual lumen output first. A 10W downlight at roughly 1100 lm may need about 6–12 fittings when typical utilisation and maintenance allowances are included. Use the calculator for the room-specific result.',
      },
      {
        title: 'How far apart should LED track lights be?',
        description:
          'Start from the beam diameter at the work plane, not a fixed distance. Flood beams usually need 20–30% overlap for uniform light, while narrow accent beams can be spaced around display positions. Calculate the spot size first, then validate the grid and photometric layout.',
      },
      {
        title: 'Should I use more, lower-wattage fixtures or fewer, higher-wattage ones?',
        description:
          'More lower-wattage fixtures with a wider beam give more uniform light and lower glare; fewer high-wattage spots create dramatic pools of light. For retail and general commercial, uniformity usually wins.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Let Our Engineers Design the Layout"
    subtitle="Send us your room plan and target lux — we will return a free photometric layout with fixture recommendations."
    actions={[
      { variant: 'primary', text: 'Request a Layout', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'Lux Calculator', href: getPermalink('/tools/lux-calculator') },
    ]}
  />

  <!-- Related tools -->
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6 lg:py-16">
    <RelatedTools tools={['lux', 'beam', 'photo', 'ugr']} />
  </section>
</Layout>
