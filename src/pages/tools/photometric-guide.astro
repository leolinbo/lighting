---
/**
 * Photometric Guide — what is photometric data, IES files, UGR, IP and IK.
 * Information-type guide page (P2 per SEO spec) covering UGR / IP / IK / IES.
 */

import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import RelatedTools from '~/components/RelatedTools.astro';
import { getPermalink, getCanonical } from '~/utils/permalinks';

const metadata = {
  title: 'Photometric Data Guide — UGR, IP, IK & IES Files Explained',
  description:
    'Understand lighting photometric data: UGR glare ratings, IP and IK protection ratings, IES/LDT files and how to read a photometric curve. Practical guide for lighting buyers.',
  canonical: String(getCanonical(getPermalink('/tools/photometric-guide'))),
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is photometric data in lighting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Photometric data describes how a luminaire distributes light: intensity in each direction, beam angle, total lumens and efficiency. It is published as photometric curves or IES/LDT files for lighting design software.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is UGR in lighting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'UGR (Unified Glare Rating) is a 0–30 scale measuring discomfort glare. EN 12464-1 recommends UGR ≤ 19 for offices and classrooms, and UGR ≤ 16 for screen-based work.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between IP and IK ratings?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'IP ratings protect against dust and water ingress (e.g. IP20 indoor, IP65 outdoor). IK ratings protect against mechanical impact (e.g. IK08, IK10 for vandal-resistant fixtures).',
      },
    },
    {
      '@type': 'Question',
      name: 'What is an IES file?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An IES file is a standard photometric data format (IESNA LM-63) used by lighting design software such as DIALux, AGi32 and Relux to simulate light distribution in 3D.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />

  <!-- Hero -->
  <section
    class="relative not-prose bg-gradient-to-b from-blue-50/60 to-transparent py-14 dark:from-slate-900/40 md:py-20"
  >
    <div class="mx-auto max-w-4xl px-4 text-center">
      <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Lighting Guide</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tighter font-heading dark:text-white md:text-5xl">
        Photometric Data Guide
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted dark:text-slate-300">
        Everything buyers need to read a luminaire datasheet: photometric curves, IES files, UGR glare ratings, IP and
        IK protection ratings — explained in plain language.
      </p>
    </div>
  </section>

  <!-- Photometric curve -->
  <section class="mx-auto max-w-5xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">What Is a Photometric Curve?</h2>
      <p class="mt-3 text-muted dark:text-slate-400">
        A photometric curve (polar diagram) shows the luminous intensity of a fixture in candela (cd) at every angle.
        The curve tells you:
      </p>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted dark:text-slate-400">
        <li>
          <strong>How narrow or wide the beam is</strong> — a tight curve means a spot optic, a broad curve means a flood.
        </li>
        <li>
          <strong>Where the light actually goes</strong> — up, down or sideways — which matters for wall washing, display
          and anti-glare design.
        </li>
        <li><strong>The beam angle</strong> — the angle where intensity falls to 50% of the peak (FWHM).</li>
        <li><strong>Efficiency</strong> — the ratio of total emitted lumens to the lamp lumens.</li>
      </ul>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-slate-700">
              <th class="py-3 pr-4 font-semibold">Term</th>
              <th class="py-3 font-semibold">Meaning</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
            <tr>
              <td class="py-3 pr-4 font-medium">Candela (cd)</td>
              <td class="py-3">Luminous intensity in a given direction</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">Lumen (lm)</td>
              <td class="py-3">Total visible light output of the fixture</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">Lux / fc</td>
              <td class="py-3">Illuminance on a surface (lm per m² / per ft²)</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">Beam angle</td>
              <td class="py-3">Angle at 50% of peak intensity (FWHM)</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">IES / LDT file</td>
              <td class="py-3">Standard photometric data format for design software</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium">UGR</td>
              <td class="py-3">Unified Glare Rating — discomfort glare scale 0–30</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted dark:text-slate-400">
        How to read it in three steps: ① find the peak intensity angle (usually straight down for downlights), ② check
        the 50% point to read the beam angle, ③ compare the curve shape — narrow and tall = spot, wide and flat = flood.
      </p>
    </div>
  </section>

  <!-- UGR -->
  <section class="mx-auto max-w-5xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">UGR — Unified Glare Rating</h2>
      <p class="mt-3 text-muted dark:text-slate-400">
        UGR measures discomfort glare on a 0–30 scale (lower is better). It is calculated from the luminaire's
        luminance, its position in the field of view and the room surfaces.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-slate-700">
              <th class="py-3 pr-4 font-semibold">UGR</th>
              <th class="py-3 font-semibold">Application</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
            <tr><td class="py-3 pr-4 font-medium">≤ 13</td><td class="py-3">Drawing offices, video conferencing</td></tr
            >
            <tr><td class="py-3 pr-4 font-medium">≤ 16</td><td class="py-3">Offices, classrooms, screen work</td></tr>
            <tr
              ><td class="py-3 pr-4 font-medium">≤ 19</td><td class="py-3">General offices, retail (EN 12464-1)</td></tr
            >
            <tr><td class="py-3 pr-4 font-medium">≤ 22</td><td class="py-3">Industrial and utility areas</td></tr>
            <tr><td class="py-3 pr-4 font-medium">≤ 25</td><td class="py-3">Circulation and storage</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted dark:text-slate-400">
        Reduce glare with deep-shielded optics, honeycomb louvers, higher cut-off angles and indirect lighting. See the
        interactive <a href="/tools/ugr-guide" class="font-semibold text-primary hover:underline">UGR guide</a>.
      </p>
    </div>
  </section>

  <!-- IP / IK -->
  <section class="mx-auto max-w-5xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">IP & IK Protection Ratings</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold dark:text-white">IP — Ingress Protection</h3>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            First digit: solids (0–6). Second digit: liquids (0–8).
          </p>
          <table class="mt-4 w-full border-collapse text-left text-sm">
            <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
              <tr><td class="py-3 pr-4 font-medium">IP20</td><td class="py-3">Indoor, dry areas (standard)</td></tr>
              <tr
                ><td class="py-3 pr-4 font-medium">IP44</td><td class="py-3">Splash-proof, bathrooms (some zones)</td
                ></tr
              >
              <tr><td class="py-3 pr-4 font-medium">IP65</td><td class="py-3">Dust-tight + water jets, outdoor</td></tr>
              <tr
                ><td class="py-3 pr-4 font-medium">IP67</td><td class="py-3">Temporary immersion, wet locations</td></tr
              >
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="text-lg font-bold dark:text-white">IK — Impact Protection</h3>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            IK rating (00–10) measures resistance to mechanical impact in joules.
          </p>
          <table class="mt-4 w-full border-collapse text-left text-sm">
            <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
              <tr><td class="py-3 pr-4 font-medium">IK05</td><td class="py-3">0.7 J — standard interior</td></tr>
              <tr><td class="py-3 pr-4 font-medium">IK07</td><td class="py-3">2 J — corridor / public areas</td></tr>
              <tr><td class="py-3 pr-4 font-medium">IK08</td><td class="py-3">5 J — vandal-resistant</td></tr>
              <tr><td class="py-3 pr-4 font-medium">IK10</td><td class="py-3">20 J — heavy vandalism / prisons</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <FAQs
    tagline="FAQs"
    title="Photometric Data Questions"
    subtitle="Common questions about IES files, UGR, IP and IK."
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'What is photometric data in lighting?',
        description:
          'It describes how a luminaire distributes light — intensity per direction, beam angle, total lumens and efficiency — usually published as curves or IES/LDT files.',
      },
      {
        title: 'What is an IES file used for?',
        description:
          'IES files let lighting design software (DIALux, AGi32, Relux) simulate real light distribution in 3D, so you can predict lux levels before installation.',
      },
      {
        title: 'What is the difference between IP and IK ratings?',
        description:
          'IP covers dust and water ingress; IK covers mechanical impact. A fixture can be IP65 (weatherproof) but low IK (fragile) — specify both for the environment.',
      },
      {
        title: 'What UGR should I specify for an office?',
        description:
          'EN 12464-1 recommends UGR ≤ 19 for general office tasks and UGR ≤ 16 for screen-based work. Lower UGR means less discomfort glare.',
      },
      {
        title: 'Do you provide IES/LDT files for your fixtures?',
        description:
          'Yes. We supply IES and LDT photometric files for our track lights and downlights, plus full photometric test reports. Request them with your project details and we will share the files.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Need Photometric Files or a Lighting Design?"
    subtitle="Ask for IES/LDT files and a free photometric layout — our engineers will model your space and confirm lux levels."
    actions={[
      { variant: 'primary', text: 'Request Photometric Files', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'UGR Guide', href: getPermalink('/tools/ugr-guide') },
    ]}
  />

  <!-- Product CTA -->
  <section class="mx-auto max-w-5xl px-4 py-8 md:px-6">
    <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6 text-center md:p-8">
      <h2 class="text-xl font-bold dark:text-white">Need Lighting Fixtures for Your Project?</h2>
      <p class="mx-auto mt-2 max-w-2xl text-muted dark:text-slate-400">
        Browse our <a class="font-semibold text-primary hover:underline" href="/products/track-lighting"
          >LED track lighting</a
        > and <a class="font-semibold text-primary hover:underline" href="/products/led-downlights">LED downlights</a>,
        or start an <a class="font-semibold text-primary hover:underline" href="/oem-odm">OEM/ODM project</a> with factory-direct
        pricing.
      </p>
      <a href="/contact" class="btn btn-primary mt-4">Request a Quote</a>
    </div>
  </section>

  <!-- Related tools -->
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6 lg:py-16">
    <RelatedTools tools={['ugr', 'cri', 'beam', 'unit']} />
  </section>
</Layout>
