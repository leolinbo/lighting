---
/**
 * UGR Guide — what is UGR, glare ratings and how to choose anti-glare fixtures.
 */

import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import RelatedTools from '~/components/RelatedTools.astro';
import { getPermalink, getCanonical } from '~/utils/permalinks';

const metadata = {
  title: 'UGR Guide — What Is Unified Glare Rating in LED Lighting?',
  description:
    'Understand UGR (Unified Glare Rating), why UGR < 19 matters for offices and what anti-glare optics to specify. UGR chart with recommended values by application.',
  canonical: String(getCanonical(getPermalink('/tools/ugr-guide'))),
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is UGR in lighting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'UGR (Unified Glare Rating) is a 0–30 scale measuring discomfort glare from a lighting installation. Lower is better: UGR < 19 is the common requirement for offices and classrooms.',
      },
    },
    {
      '@type': 'Question',
      name: 'What UGR rating should offices use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'EN 12464-1 recommends UGR ≤ 19 for most office and educational tasks, and UGR ≤ 16 for screen-based work (video conferencing and display rooms).',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I reduce glare in LED lighting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use deep-recessed or shielded optics, honeycomb (anti-glare) louvers, higher cut-off angles and indirect/ambient light. Fixtures with a low UGR rating already bundle these.',
      },
    },
  ],
};

const ugrRows = [
  {
    value: 10,
    label: 'Ideal',
    detail: 'Very dark ceilings and accent lighting; only reachable with deep-shielded optics.',
  },
  { value: 13, label: 'Excellent', detail: 'Preferred for meeting rooms and video conferencing.' },
  { value: 16, label: 'Very good', detail: 'General office and educational spaces.' },
  { value: 19, label: 'Good / standard', detail: 'Maximum commonly specified for offices and retail (EN 12464-1).' },
  { value: 22, label: 'Acceptable', detail: 'Industrial and utility areas where glare is less critical.' },
  { value: 25, label: 'Poor', detail: 'High glare; only for circulation and storage areas.' },
  { value: 28, label: 'Very poor', detail: 'Discomfort glare likely; should be avoided where people work.' },
];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />

  <!-- Hero -->
  <section
    class="relative not-prose bg-gradient-to-b from-blue-50/60 to-transparent py-14 dark:from-slate-900/40 md:py-20"
  >
    <div class="mx-auto max-w-4xl px-4 text-center">
      <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Lighting Guide</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tighter font-heading dark:text-white md:text-5xl">
        UGR Guide — Unified Glare Rating Explained
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted dark:text-slate-300">
        What is UGR, why do offices specify UGR &lt; 19, and which anti-glare optics reduce discomfort glare? A
        practical guide for buyers and specifiers.
      </p>
    </div>
  </section>

  <!-- Interactive UGR -->
  <section class="mx-auto max-w-5xl px-4 pb-6 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-xl font-bold dark:text-white">Glare Level Simulator</h2>
        <div class="flex items-center gap-3">
          <label class="text-sm text-muted dark:text-slate-400" for="ugr-range">UGR</label>
          <input id="ugr-range" type="range" min="10" max="28" step="1" value="19" class="w-44 accent-primary" />
          <span id="ugr-value" class="w-8 text-right text-sm font-bold text-primary dark:text-blue-300">19</span>
        </div>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <p class="mb-2 text-center text-sm font-semibold text-muted dark:text-slate-400">Glare experience</p>
          <div
            id="ugr-visual"
            class="relative h-44 overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700"
          >
            <!-- simulated glare circles -->
            <div
              class="ugr-glare absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full"
              style="width:90px;height:90px;"
            >
            </div>
            <div class="ugr-glare absolute left-[18%] top-[30%] rounded-full" style="width:40px;height:40px;"></div>
            <div class="ugr-glare absolute right-[20%] top-[25%] rounded-full" style="width:35px;height:35px;"></div>
            <div class="ugr-glare absolute bottom-[20%] left-[30%] rounded-full" style="width:30px;height:30px;"></div>
          </div>
        </div>
        <div>
          <p class="mb-2 text-center text-sm font-semibold text-muted dark:text-slate-400">Assessment</p>
          <div class="flex h-44 flex-col justify-center rounded-xl border border-gray-200 p-5 dark:border-slate-700">
            <p id="ugr-tier-label" class="text-lg font-bold">Good / standard — 19</p>
            <p id="ugr-tier-detail" class="mt-1 text-sm text-muted dark:text-slate-400">
              Maximum commonly specified for offices and retail (EN 12464-1).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UGR Table -->
  <section class="mx-auto max-w-5xl px-4 pb-4 md:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="text-2xl font-bold md:text-3xl">UGR Values and Their Meaning</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-slate-700">
              <th class="py-3 pr-4 font-semibold">UGR</th>
              <th class="py-3 pr-4 font-semibold">Rating</th>
              <th class="py-3 font-semibold">Where to use</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
            {
              ugrRows.map((r) => (
                <tr>
                  <td class="py-3 pr-4 font-medium">{r.value}</td>
                  <td class="py-3 pr-4">{r.label}</td>
                  <td class="py-3">{r.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <FAQs
    tagline="FAQs"
    title="UGR Questions"
    subtitle="Common questions about glare ratings and anti-glare lighting."
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'What is UGR in lighting?',
        description:
          'UGR (Unified Glare Rating) is a 0–30 scale measuring discomfort glare. Lower values mean less glare. UGR ≤ 19 is the typical office and classroom requirement.',
      },
      {
        title: 'What UGR rating should offices use?',
        description:
          'EN 12464-1 recommends UGR ≤ 19 for most office tasks and UGR ≤ 16 for screen-based work and meeting rooms with video conferencing.',
      },
      {
        title: 'How do I reduce glare in LED lighting?',
        description:
          'Specify deep-shielded optics, honeycomb anti-glare louvers, high cut-off angles, or indirect lighting. Low-UGR fixtures combine these features and are tested to a published UGR value.',
      },
      {
        title: 'Do ENCORE fixtures have low UGR options?',
        description:
          'Yes. Several of our downlight and track light families offer deep anti-glare versions with honeycomb/reflector options targeting UGR &lt; 19. Share your room geometry and we will confirm the achieved UGR.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Specify Low-Glare Lighting"
    subtitle="Our engineers will help you hit your UGR target with the right optics — offices, classrooms and meeting rooms."
    actions={[
      { variant: 'primary', text: 'Talk to an Engineer', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'View LED Downlights', href: getPermalink('/products/led-downlights') },
      { variant: 'secondary', text: 'OEM/ODM Low-Glare', href: getPermalink('/oem-odm') },
    ]}
  />

  <!-- Related tools -->
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6 lg:py-16">
    <RelatedTools tools={['photo', 'beam', 'cri', 'lux']} />
  </section>
</Layout>

<script is:inline>
  (() => {
    const range = document.getElementById('ugr-range');
    const valueEl = document.getElementById('ugr-value');
    const tierLabel = document.getElementById('ugr-tier-label');
    const tierDetail = document.getElementById('ugr-tier-detail');

    const ROWS = [
      {
        value: 10,
        label: 'Ideal — 10',
        detail: 'Very dark ceilings and accent lighting; only reachable with deep-shielded optics.',
      },
      { value: 13, label: 'Excellent — 13', detail: 'Preferred for meeting rooms and video conferencing.' },
      { value: 16, label: 'Very good — 16', detail: 'General office and educational spaces.' },
      {
        value: 19,
        label: 'Good / standard — 19',
        detail: 'Maximum commonly specified for offices and retail (EN 12464-1).',
      },
      { value: 22, label: 'Acceptable — 22', detail: 'Industrial and utility areas where glare is less critical.' },
      { value: 25, label: 'Poor — 25', detail: 'High glare; only for circulation and storage areas.' },
      { value: 28, label: 'Very poor — 28', detail: 'Discomfort glare likely; should be avoided where people work.' },
    ];

    const update = () => {
      const v = Number(range.value);
      valueEl.textContent = String(v);
      // Glare intensity: higher UGR -> brighter/stronger halos
      const intensity = (v - 10) / 18; // 0..1
      document.querySelectorAll('.ugr-glare').forEach((el) => {
        const glow = 30 + intensity * 90;
        el.style.background = `radial-gradient(circle, rgba(255,255,220,${0.35 + intensity * 0.6}), rgba(255,255,255,0))`;
        el.style.boxShadow = `0 0 ${glow}px ${glow / 3}px rgba(255,255,255,${0.2 + intensity * 0.5})`;
      });
      const t = ROWS.reduce((best, cur) => (Math.abs(cur.value - v) < Math.abs(best.value - v) ? cur : best));
      tierLabel.textContent = t.label;
      tierDetail.textContent = t.detail;
    };

    range.addEventListener('input', update);
    update();
  })();
</script>
