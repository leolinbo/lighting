---
/**
 * Lighting Unit Converter — length (m/ft), area (m²/ft²), illuminance
 * (lux/fc), power (W/VA) quick conversions for B2B buyers.
 */

import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import RelatedTools from '~/components/RelatedTools.astro';
import { getPermalink, getCanonical } from '~/utils/permalinks';

const metadata = {
  title: 'Lighting Unit Converter — m to ft, Lux to Foot-Candles, W to VA',
  description:
    'Quick lighting unit conversions: meters to feet, square meters to square feet, lux to foot-candles, watts to VA. Free online converter for LED lighting spec sheets.',
  canonical: String(getCanonical(getPermalink('/tools/unit-converter'))),
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I convert lux to foot-candles?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'One foot-candle equals 10.76 lux. To convert lux to foot-candles divide by 10.76; to convert foot-candles to lux multiply by 10.76.',
      },
    },
    {
      '@type': 'Question',
      name: 'How many feet are in a meter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'One meter equals 3.28084 feet. One foot equals 0.3048 meters.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I convert watts to VA?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'VA = watts ÷ power factor. LED drivers typically have a power factor of 0.9–0.95, so 15W ≈ 16VA.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />

  <!-- Hero -->
  <section
    class="relative not-prose bg-gradient-to-b from-blue-50/60 to-transparent py-14 dark:from-slate-900/40 md:py-20"
  >
    <div class="mx-auto max-w-4xl px-4 text-center">
      <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Lighting Tool</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tighter font-heading dark:text-white md:text-5xl">
        Lighting Unit Converter
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted dark:text-slate-300">
        Convert between metric and imperial units used on LED lighting spec sheets: meters ↔ feet, m² ↔ ft², lux ↔
        foot-candles and watts ↔ VA.
      </p>
    </div>
  </section>

  <!-- Converter -->
  <section class="mx-auto max-w-4xl px-4 pb-6 md:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Length -->
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="text-lg font-bold dark:text-white">Length</h2>
        <p class="mt-1 text-xs text-muted dark:text-slate-400">Mounting heights, distances</p>
        <div class="mt-4 flex items-center gap-2">
          <input id="uc-length-value" type="number" step="any" value="3" class="uc-input w-full" />
          <select id="uc-length-from" class="uc-select w-28">
            <option value="m">m</option>
            <option value="ft">ft</option>
          </select>
          <span class="text-muted">→</span>
          <span id="uc-length-result" class="w-full text-right font-bold text-primary dark:text-blue-300">9.84 ft</span>
        </div>
        <p class="mt-2 text-xs text-muted dark:text-slate-400">Formula: 1 m = 3.28084 ft; 1 ft = 0.3048 m</p>
      </div>

      <!-- Area -->
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="text-lg font-bold dark:text-white">Area</h2>
        <p class="mt-1 text-xs text-muted dark:text-slate-400">Room and floor areas</p>
        <div class="mt-4 flex items-center gap-2">
          <input id="uc-area-value" type="number" step="any" value="20" class="uc-input w-full" />
          <select id="uc-area-from" class="uc-select w-28">
            <option value="m2">m²</option>
            <option value="ft2">ft²</option>
          </select>
          <span class="text-muted">→</span>
          <span id="uc-area-result" class="w-full text-right font-bold text-primary dark:text-blue-300">215.28 ft²</span
          >
        </div>
        <p class="mt-2 text-xs text-muted dark:text-slate-400">Formula: 1 m² = 10.7639 ft²; 1 ft² = 0.092903 m²</p>
      </div>

      <!-- Illuminance -->
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="text-lg font-bold dark:text-white">Illuminance</h2>
        <p class="mt-1 text-xs text-muted dark:text-slate-400">Lux ↔ foot-candles</p>
        <div class="mt-4 flex items-center gap-2">
          <input id="uc-lux-value" type="number" step="any" value="500" class="uc-input w-full" />
          <select id="uc-lux-from" class="uc-select w-32">
            <option value="lux">lux</option>
            <option value="fc">fc</option>
          </select>
          <span class="text-muted">→</span>
          <span id="uc-lux-result" class="w-full text-right font-bold text-primary dark:text-blue-300">46.45 fc</span>
        </div>
        <p class="mt-2 text-xs text-muted dark:text-slate-400">Formula: 1 fc = 10.76 lux</p>
      </div>

      <!-- Power -->
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="text-lg font-bold dark:text-white">Power</h2>
        <p class="mt-1 text-xs text-muted dark:text-slate-400">Watts ↔ VA (power factor 0.95)</p>
        <div class="mt-4 flex items-center gap-2">
          <input id="uc-watt-value" type="number" step="any" value="15" class="uc-input w-full" />
          <select id="uc-watt-from" class="uc-select w-28">
            <option value="w">W</option>
            <option value="va">VA</option>
          </select>
          <span class="text-muted">→</span>
          <span id="uc-watt-result" class="w-full text-right font-bold text-primary dark:text-blue-300">15.79 VA</span>
        </div>
        <p class="mt-2 text-xs text-muted dark:text-slate-400">Formula: VA = W ÷ power factor (0.95)</p>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <FAQs
    tagline="FAQs"
    title="Unit Conversion Questions"
    subtitle="Quick reference for the conversions used across our tools and spec sheets."
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'How do I convert lux to foot-candles?',
        description:
          '1 foot-candle = 10.76 lux. Divide lux by 10.76 to get foot-candles; multiply foot-candles by 10.76 to get lux.',
      },
      {
        title: 'How many feet are in a meter?',
        description: '1 meter = 3.28084 feet; 1 foot = 0.3048 meters. For ceiling heights, 3 m ≈ 9.8 ft.',
      },
      {
        title: 'How do I convert watts to VA?',
        description:
          'VA = watts ÷ power factor. LED drivers usually have PF 0.9–0.95, so 15W ≈ 16VA. This matters when sizing circuits and generators.',
      },
      {
        title: 'Why do US projects use foot-candles?',
        description:
          'The US market commonly specifies illuminance in foot-candles (lumens per square foot) while Europe and Asia use lux (lumens per square meter). 1 fc = 10.76 lux.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Spec Sheets in Your Units"
    subtitle="Ask for photometric files (IES/LDT), datasheets and cut sheets in metric or imperial units."
    actions={[
      { variant: 'primary', text: 'Request Datasheets', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'Beam Angle Calculator', href: getPermalink('/beam-angle-calculator') },
    ]}
  />

  <!-- Product CTA -->
  <section class="mx-auto max-w-5xl px-4 py-8 md:px-6">
    <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6 text-center md:p-8">
      <h2 class="text-xl font-bold dark:text-white">Need Lighting Fixtures for Your Project?</h2>
      <p class="mx-auto mt-2 max-w-2xl text-muted dark:text-slate-400">
        Browse our <a class="font-semibold text-primary hover:underline" href="/products/track-lighting"
          >LED track lighting</a
        > and <a class="font-semibold text-primary hover:underline" href="/products/led-downlights">LED downlights</a>,
        or start an <a class="font-semibold text-primary hover:underline" href="/oem-odm">OEM/ODM project</a> with factory-direct
        pricing.
      </p>
      <a href="/contact" class="btn btn-primary mt-4">Request a Quote</a>
    </div>
  </section>

  <!-- Related tools -->
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6 lg:py-16">
    <RelatedTools tools={['lux', 'beam', 'cct', 'photo']} />
  </section>
</Layout>

<style is:inline>
  .uc-input {
    border-radius: 0.5rem;
    border: 1px solid var(--aw-color-gray-200, #e5e7eb);
    background: var(--aw-color-white, #fff);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .dark .uc-input {
    border-color: var(--aw-color-slate-600, #475569);
    background: var(--aw-color-slate-800, #1e293b);
    color: var(--aw-color-slate-200, #e2e8f0);
  }
  .uc-select {
    border-radius: 0.5rem;
    border: 1px solid var(--aw-color-gray-300, #d1d5db);
    background: var(--aw-color-white, #fff);
    padding: 0.5rem;
    font-size: 0.875rem;
  }
  .dark .uc-select {
    border-color: var(--aw-color-slate-600, #475569);
    background: var(--aw-color-slate-800, #1e293b);
    color: var(--aw-color-slate-200, #e2e8f0);
  }
</style>

<script is:inline>
  (() => {
    const M2F = 3.28084;
    const bind = (valueId, fromId, resultId, convert) => {
      const valueEl = document.getElementById(valueId);
      const fromEl = document.getElementById(fromId);
      const resultEl = document.getElementById(resultId);
      if (!valueEl || !fromEl || !resultEl) return;
      const update = () => {
        const v = Number(valueEl.value);
        if (!Number.isFinite(v)) {
          resultEl.textContent = '—';
          return;
        }
        resultEl.textContent = convert(v, fromEl.value);
      };
      valueEl.addEventListener('input', update);
      fromEl.addEventListener('change', update);
      update();
    };

    const fmt = (v, d = 2) => v.toLocaleString('en-US', { maximumFractionDigits: d });

    bind('uc-length-value', 'uc-length-from', 'uc-length-result', (v, u) =>
      u === 'm' ? `${fmt(v * M2F)} ft` : `${fmt(v / M2F)} m`
    );
    bind('uc-area-value', 'uc-area-from', 'uc-area-result', (v, u) =>
      u === 'm2' ? `${fmt(v * M2F * M2F)} ft²` : `${fmt(v / (M2F * M2F))} m²`
    );
    bind('uc-lux-value', 'uc-lux-from', 'uc-lux-result', (v, u) =>
      u === 'lux' ? `${fmt(v / 10.76)} fc` : `${fmt(v * 10.76)} lux`
    );
    bind('uc-watt-value', 'uc-watt-from', 'uc-watt-result', (v, u) =>
      u === 'w' ? `${fmt(v / 0.95)} VA` : `${fmt(v * 0.95)} W`
    );
  })();
</script>
