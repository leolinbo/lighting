---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuoteForm from '~/components/QuoteForm.astro';

const metadata = {
  title: 'Commercial LED Lighting Manufacturer',
  description:
    'Commercial LED lighting manufacturer for retail, hospitality and office projects. Track lights, downlights and magnetic systems with OEM/ODM service.',
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lightoem.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Commercial Lighting',
      item: 'https://lightoem.com/products/commercial-lighting',
    },
  ],
};
const productJson = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Commercial LED Lighting — Track, Downlight & Magnetic Systems',
  description:
    'Commercial LED lighting manufacturer for retail, hospitality and office projects. Track lights, downlights and magnetic systems with OEM/ODM service.',
  brand: { '@type': 'Brand', name: 'ENCORE' },
  category: 'Commercial LED Lighting',
  image: ['https://lightoem.com/images/products/prod-ovega-web-01.jpg'],
  manufacturer: { '@type': 'Organization', name: 'ENCORE', url: 'https://lightoem.com/' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
  },
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: 'Wattage',
      value: '5W–60W across cylinder, linear, motorized and wall luminaire ranges',
    },
    { '@type': 'PropertyValue', name: 'Color Temperature', value: '2700K / 3000K / 3500K / 4000K' },
    { '@type': 'PropertyValue', name: 'CRI', value: 'CRI 90+ options' },
    { '@type': 'PropertyValue', name: 'Beam Angle', value: '10°–90° depending on family' },
    { '@type': 'PropertyValue', name: 'Dimming', value: 'TRIAC / 0-10V / DALI' },
    { '@type': 'PropertyValue', name: 'Certification', value: 'ETL, CE, SAA, ISO9001' },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJson)} />
  <Content
    tagline="Products"
    title="Commercial LED Lighting Manufacturer"
    subtitle="Complete commercial lighting solutions for retail, hospitality, office, and institutional spaces"
    items={[
      {
        title: 'Cylinder Light System',
        description:
          'Modern cylindrical luminaires with CRI 90+ color quality and 10°–60° beam options bring clean lines and high performance to contemporary retail and hospitality spaces, with suspended, surface and recessed mounting.',
      },
      {
        title: 'Linear Light System',
        description:
          'Linear LED lighting for architectural integration delivers uniform, low-glare illumination for offices and commercial corridors. Available with 0-10V or DALI dimming for suspended, surface and recessed installations.',
      },
      {
        title: 'Motorized Remote Controlled Lighting',
        description:
          'Motorized track lights with remote-controlled beam positioning let you adjust accent angles on demand — ideal for showrooms and dynamic retail layouts that change throughout the day.',
      },
      {
        title: 'Wall Luminaires & ETL Downlights',
        description:
          'Wall-mounted luminaires and ETL-certified downlights built for North American commercial projects, combining decorative output with CRI 90+ performance and TRIAC/DALI dimming.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-wallwash-web-03.jpg',
      alt: 'ENCORE Commercial Lighting Solutions',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Complete Commercial Lighting</h3>
      Cylinder, linear, motorized, and wall-mounted solutions for every project.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our commercial lighting collection</p>
    <ProductGallery
      images={[
        {
          src: '/images/products/prod-movia-web-01.jpg',
          alt: 'MOVIA Motorized Track Light',
          title: 'MOVIA Motorized Track Light',
        },
        {
          src: '/images/products/prod-movia-web-02.jpg',
          alt: 'MOVIA Motorized Light Angle',
          title: 'MOVIA — Angle View',
        },
        {
          src: '/images/products/prod-cylinder-nova-300.jpg',
          alt: 'NOVA Cylinder Light',
          title: 'NOVA Cylinder Light',
        },
        {
          src: '/images/products/prod-cylinder-nova-500.jpg',
          alt: 'NOVA Cylinder Light 500',
          title: 'NOVA Cylinder — 500',
        },
        {
          src: '/images/products/prod-cylinder-nova-800.jpg',
          alt: 'NOVA Cylinder Light 800',
          title: 'NOVA Cylinder — 800',
        },
        {
          src: '/images/products/prod-cylinder-galaxy-01.png',
          alt: 'Galaxy Cylinder Light',
          title: 'Galaxy Cylinder Light',
        },
        {
          src: '/images/products/prod-cylinder-galaxy-02.png',
          alt: 'Galaxy Cylinder Light Angle',
          title: 'Galaxy Cylinder — Angle',
        },
        {
          src: '/images/products/prod-cylinder-galaxy-03.png',
          alt: 'Galaxy Cylinder Light DS',
          title: 'Galaxy Cylinder — DS',
        },
        { src: '/images/products/prod-linear-atro-01.png', alt: 'ATRO Linear Light', title: 'ATRO Linear Light' },
        {
          src: '/images/products/prod-linear-atro-02.png',
          alt: 'ATRO Linear Light Surface',
          title: 'ATRO Linear — Surface',
        },
        { src: '/images/products/prod-linear-banner.png', alt: 'Linear Light Banner', title: 'Linear Light — Series' },
        { src: '/images/products/prod-strip-fs28-120.png', alt: 'FS28 Strip Light', title: 'FS28 Strip Light' },
        { src: '/images/products/prod-strip-fs34-160.png', alt: 'FS34 Strip Light', title: 'FS34 Strip Light' },
      ]}
    />
  </section>

  <!-- Related reading -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <h2 class="text-2xl font-bold dark:text-white">Commercial Lighting Resources</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/how-to-choose-led-track-lighting-manufacturer-2026/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">How to Choose an LED Track Lighting Manufacturer →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >Vet a commercial lighting factory vs a trading desk.</span
        >
      </a>
      <a
        href="/oem-led-lighting-manufacturer-6-step-sourcing-checklist/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">OEM LED Lighting: 6-Step Sourcing Checklist →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >Spec, sample, certify and QC a commercial lighting order.</span
        >
      </a>
      <a
        href="/custom-led-track-lighting-what-you-can-customize-moq-lead-time/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">Custom LED Lighting: MOQ &amp; Lead Time →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >What you can customize across our commercial families.</span
        >
      </a>
    </div>
  </section>

  <!-- RFQ -->
  <section id="get-quote" class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <QuoteForm product="Commercial Lighting" title="Request Commercial Lighting Quote" />
  </section>
</Layout>
