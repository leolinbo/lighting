---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuoteForm from '~/components/QuoteForm.astro';

const metadata = {
  title: 'Magnetic Track Lighting System Manufacturer',
  description:
    'Magnetic track lighting manufacturer offering slim 5mm, 15mm and 20mm systems for modern interiors. CRI 90+, OEM/ODM and ETL/CE certified factory pricing.',
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lightoem.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Magnetic Track Lights',
      item: 'https://lightoem.com/products/magnetic-track-lights',
    },
  ],
};
const productJson = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Magnetic Track Lighting Systems — AURA / DISC / GRIDIS / NOVA / LATTICE',
  description:
    'Magnetic track lighting manufacturer offering slim 5mm, 15mm and 20mm systems for modern interiors. CRI 90+, OEM/ODM and ETL/CE certified factory pricing.',
  brand: { '@type': 'Brand', name: 'ENCORE' },
  category: 'Magnetic Track Lighting',
  image: ['https://lightoem.com/images/products/prod-movia-web-01.jpg'],
  manufacturer: { '@type': 'Organization', name: 'ENCORE', url: 'https://lightoem.com/' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Wattage', value: '5W–30W (AURA/DISC/GRIDIS/NOVA/LATTICE series)' },
    { '@type': 'PropertyValue', name: 'Color Temperature', value: '2700K / 3000K / 4000K' },
    { '@type': 'PropertyValue', name: 'CRI', value: 'CRI 90+' },
    { '@type': 'PropertyValue', name: 'Beam Angle', value: '15°–60°' },
    { '@type': 'PropertyValue', name: 'Dimming', value: 'TRIAC / Zigbee / Bluetooth' },
    { '@type': 'PropertyValue', name: 'Track Profile', value: 'Slim 5mm, 15mm and 20mm magnetic track' },
    { '@type': 'PropertyValue', name: 'Certification', value: 'ETL, CE, ISO9001' },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJson)} />
  <Content
    tagline="Products"
    title="Magnetic Track Lighting Manufacturer"
    subtitle="Next-generation modular track lighting with magnetic connection system — AURA, DISC, GRIDIS, NOVA, LATTICE series"
    items={[
      {
        title: 'Magnetic Track System',
        description:
          'Our magnetic track lighting uses a snap-in magnetic connection for effortless fixture installation and repositioning. Available in slim 5mm, 15mm and 20mm profiles with AURA, DISC, GRIDIS, NOVA and LATTICE fixtures from 5W to 30W.',
      },
      {
        title: 'Flexible Configuration',
        description:
          'Configure any layout with multiple track lengths, L/T/X connectors and surface-mounted or recessed options. With 15°–60° beam angles and CRI 90+, the system adapts as your display or store layout changes.',
      },
      {
        title: 'Modern Aesthetic',
        description:
          'Sleek, minimalist luminaires with CRI 90+ color quality blend into contemporary interiors. Ideal for high-end retail, modern offices and residential projects where the fixture should disappear into the architecture.',
      },
      {
        title: 'Smart Compatible',
        description:
          'Compatible with leading smart control systems including TRIAC, Zigbee and Bluetooth for dimming, color tuning and automated lighting scenes — without rewiring.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-cutlight-web-03.jpg',
      alt: 'ENCORE Magnetic Track Lighting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The Future of Track Lighting</h3>
      Magnetic connection for effortless installation and reconfiguration.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our lighting collection</p>
    <ProductGallery
      images={[
        {
          src: '/images/products/prod-magnet-aura-01.png',
          alt: 'AURA Magnetic Track Light',
          title: 'AURA Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-aura-02.png',
          alt: 'AURA Magnetic Light Angle',
          title: 'AURA — Angle View',
        },
        {
          src: '/images/products/prod-magnet-disc-01.png',
          alt: 'DISC Magnetic Track Light',
          title: 'DISC Magnetic Light',
        },
        { src: '/images/products/prod-magnet-disc-02.png', alt: 'DISC Magnetic Light Detail', title: 'DISC — Detail' },
        {
          src: '/images/products/prod-magnet-gridis-01.png',
          alt: 'GRIDIS Magnetic Light',
          title: 'GRIDIS Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-nova-orb.png',
          alt: 'NOVA Orb Magnetic Light',
          title: 'NOVA-Orb Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-nova-cylinder.png',
          alt: 'NOVA Cylinder Magnetic',
          title: 'NOVA-Cylinder Magnetic',
        },
        {
          src: '/images/products/prod-magnet-lattice-01.png',
          alt: 'LATTICE Magnetic Light',
          title: 'LATTICE Magnetic Light',
        },
      ]}
    />
  </section>

  <!-- Related reading -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <h2 class="text-2xl font-bold dark:text-white">Magnetic Track Lighting Resources</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/blog/custom-led-track-lighting-what-you-can-customize-moq-lead-time/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">Custom LED Track Lighting: MOQ &amp; Lead Time →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >The customization menu and realistic minimums for modern interiors.</span
        >
      </a>
      <a
        href="/blog/oem-led-lighting-manufacturer-6-step-sourcing-checklist/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">OEM LED Lighting: 6-Step Sourcing Checklist →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >Source your branded magnetic track system the right way.</span
        >
      </a>
      <a
        href="/products/compare/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">Compare All Product Series →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >VEGA, OVEGA, IMAX, FLEX, magnetic and downlight specs side by side.</span
        >
      </a>
    </div>
  </section>

  <!-- RFQ -->
  <section id="get-quote" class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <QuoteForm product="Magnetic Track Lights" title="Request Magnetic Track Light Quote" />
  </section>
</Layout>
