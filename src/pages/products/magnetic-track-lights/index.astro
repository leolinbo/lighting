---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuoteForm from '~/components/QuoteForm.astro';

const metadata = {
  title: 'Magnetic Track Lighting System Manufacturer',
  description:
    'Magnetic track lighting manufacturer offering slim 5mm, 15mm and 20mm systems for modern interiors. CRI 90+, OEM/ODM and ETL/CE certified factory pricing.',
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://astrowindwopress.vercel.app/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Magnetic Track Lights',
      item: 'https://astrowindwopress.vercel.app/products/magnetic-track-lights',
    },
  ],
};
const productJson = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Magnetic Track Lighting Systems — AURA / DISC / GRIDIS / NOVA / LATTICE',
  description:
    'Magnetic track lighting manufacturer offering slim 5mm, 15mm and 20mm systems for modern interiors. CRI 90+, OEM/ODM and ETL/CE certified factory pricing.',
  brand: { '@type': 'Brand', name: 'ENCORE' },
  category: 'Magnetic Track Lighting',
  image: ['https://astrowindwopress.vercel.app/images/products/prod-movia-web-01.jpg'],
  manufacturer: { '@type': 'Organization', name: 'ENCORE', url: 'https://astrowindwopress.vercel.app/' },
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJson)} />
  <Content
    tagline="Products"
    title="Magnetic Track Lighting Manufacturer"
    subtitle="Next-generation modular track lighting with magnetic connection system — AURA, DISC, GRIDIS, NOVA, LATTICE series"
    items={[
      {
        title: 'Magnetic Track System',
        description:
          'Innovative magnetic track lighting with easy snap-in fixture installation. Modular design allows for quick reconfiguration as lighting needs change.',
      },
      {
        title: 'Flexible Configuration',
        description:
          'Multiple track lengths, connector options (L/T/X shape), and fixture types. Surface-mounted and recessed versions available.',
      },
      {
        title: 'Modern Aesthetic',
        description:
          'Sleek, minimalist design that blends into contemporary interiors. Ideal for high-end retail, modern offices, and residential projects.',
      },
      {
        title: 'Smart Compatible',
        description:
          'Compatible with leading smart control systems for dimming, color tuning, and automated lighting scenes.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-cutlight-web-03.jpg',
      alt: 'ENCORE Magnetic Track Lighting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The Future of Track Lighting</h3>
      Magnetic connection for effortless installation and reconfiguration.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our lighting collection</p>
    <ProductGallery
      images={[
        {
          src: '/images/products/prod-magnet-aura-01.png',
          alt: 'AURA Magnetic Track Light',
          title: 'AURA Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-aura-02.png',
          alt: 'AURA Magnetic Light Angle',
          title: 'AURA — Angle View',
        },
        {
          src: '/images/products/prod-magnet-disc-01.png',
          alt: 'DISC Magnetic Track Light',
          title: 'DISC Magnetic Light',
        },
        { src: '/images/products/prod-magnet-disc-02.png', alt: 'DISC Magnetic Light Detail', title: 'DISC — Detail' },
        {
          src: '/images/products/prod-magnet-gridis-01.png',
          alt: 'GRIDIS Magnetic Light',
          title: 'GRIDIS Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-nova-orb.png',
          alt: 'NOVA Orb Magnetic Light',
          title: 'NOVA-Orb Magnetic Light',
        },
        {
          src: '/images/products/prod-magnet-nova-cylinder.png',
          alt: 'NOVA Cylinder Magnetic',
          title: 'NOVA-Cylinder Magnetic',
        },
        {
          src: '/images/products/prod-magnet-lattice-01.png',
          alt: 'LATTICE Magnetic Light',
          title: 'LATTICE Magnetic Light',
        },
      ]}
    />
  </section>

  <!-- RFQ -->
  <section id="get-quote" class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <QuoteForm product="Magnetic Track Lights" title="Request Magnetic Track Light Quote" />
  </section>
</Layout>
