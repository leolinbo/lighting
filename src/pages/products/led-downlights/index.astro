---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import CctGuide from '~/components/CctGuide.astro';
import BeamSpreadTable from '~/components/BeamSpreadTable.astro';

const metadata = {
  title: 'LED Downlight Manufacturer & Wholesale Supplier',
  description:
    'LED downlight manufacturer and wholesale supplier of recessed downlights for commercial projects. CRI 90+ options with ETL/CE/ISO certified OEM/ODM service.',
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lightoem.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'LED Downlights',
      item: 'https://lightoem.com/products/led-downlights',
    },
  ],
};
const productJson = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'LED Downlights — ELLA / AVA / Galaxy / DELLA',
  description:
    'LED downlight manufacturer and wholesale supplier of recessed downlights for commercial projects. CRI 90+ options with ETL/CE/ISO certified OEM/ODM service.',
  brand: { '@type': 'Brand', name: 'ENCORE' },
  category: 'LED Downlights',
  image: ['https://lightoem.com/images/products/prod-ella-web-01.jpg'],
  manufacturer: { '@type': 'Organization', name: 'ENCORE', url: 'https://lightoem.com/' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Wattage', value: '5W–20W depending on series (DELLA/ELLA/Galaxy/AVA)' },
    {
      '@type': 'PropertyValue',
      name: 'Color Temperature',
      value: '2700K / 3000K / 4000K, tunable white on Galaxy series',
    },
    { '@type': 'PropertyValue', name: 'CRI', value: 'CRI 90–95' },
    { '@type': 'PropertyValue', name: 'Beam Angle', value: '24°–60°' },
    { '@type': 'PropertyValue', name: 'Dimming', value: 'TRIAC / DALI / Tunable' },
    { '@type': 'PropertyValue', name: 'IP Rating', value: 'IP20 (indoor recessed downlights)' },
    { '@type': 'PropertyValue', name: 'Certification', value: 'ETL, CE, SAA, ISO9001' },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJson)} />
  <Content
    tagline="Products"
    title="LED Downlight Manufacturer"
    subtitle="Complete downlight systems for every ceiling height and application"
    items={[
      {
        title: 'DELLA Mini Downlight System',
        description:
          'DELLA is our ultra-compact mini downlight system for tight ceiling spaces, available in 5W–10W with 24°–60° beams and CRI 90+. It is ideal for residential and light commercial applications where low glare and a small footprint matter.',
      },
      {
        title: 'ELLA Downlight System',
        description:
          'ELLA is a super modular downlight system that combines hotel, residential, commercial, deep anti-glare and wall-washing optics in one family. With 5W–20W options, CRI 90–95, TRIAC/DALI dimming and tunable white, it covers virtually all indoor applications.',
      },
      {
        title: 'Galaxy Downlight System',
        description:
          'Galaxy is compact but powerful, delivering high output with tunable white and smart dimming. Engineered for high-ceiling applications from 4m to 8m, it pairs precise 24°–60° beam control with CRI 90–95 for warehouses, atriums and showrooms.',
      },
      {
        title: 'AVA MR16 Modular Downlight System',
        description:
          'AVA is an MR16-compatible modular downlight system that gives flexible beam angle and lamp replacement options. With 5W–12W options, CRI 90+ and TRIAC dimming, it is a service-friendly choice for specifiers who need to change optics in the field.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-optics-web-08.jpg',
      alt: 'ENCORE LED Downlights',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Versatile Downlight Solutions</h3>
      From 2-inch mini downlights to high-ceiling commercial solutions.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">
      ELLA Downlight Gallery
    </h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our ELLA downlight collection</p>
    <ProductGallery
      images={[
        { src: '/images/products/prod-ella-web-01.jpg', alt: 'ELLA Downlight', title: 'ELLA Downlight' },
        { src: '/images/products/prod-ella-web-02.jpg', alt: 'ELLA Downlight Front View', title: 'ELLA — Front View' },
        { src: '/images/products/prod-ella-web-03.jpg', alt: 'ELLA Downlight Side View', title: 'ELLA — Side View' },
        {
          src: '/images/products/prod-ella-web-05.jpg',
          alt: 'ELLA Downlight Installation',
          title: 'ELLA — Installation',
        },
        {
          src: '/images/products/prod-ella-web-06.jpg',
          alt: 'ELLA Downlight Application',
          title: 'ELLA — Application',
        },
        { src: '/images/products/prod-ella-web-07.jpg', alt: 'ELLA Downlight Close Up', title: 'ELLA — Close Up' },
        { src: '/images/products/prod-ava-01.png', alt: 'AVA MR16 Downlight', title: 'AVA MR16 Downlight' },
        { src: '/images/products/prod-ava-02.png', alt: 'AVA MR16 Downlight 15W', title: 'AVA — 15W Model' },
        { src: '/images/products/prod-ava-showcase.png', alt: 'AVA Downlight Showcase', title: 'AVA — Showcase' },
        { src: '/images/products/prod-galaxy-01.jpg', alt: 'Galaxy Downlight', title: 'Galaxy Downlight' },
        {
          src: '/images/products/prod-galaxy-02.jpg',
          alt: 'Galaxy Downlight Production',
          title: 'Galaxy — Production',
        },
        { src: '/images/products/prod-galaxy-03.jpg', alt: 'Galaxy Downlight Angle', title: 'Galaxy — Angle View' },
        { src: '/images/products/prod-della-01.png', alt: 'DELLA Mini Downlight', title: 'DELLA Mini Downlight' },
        { src: '/images/products/prod-della-02.png', alt: 'DELLA Mini Downlight Design', title: 'DELLA — Design' },
        { src: '/images/products/prod-della-03.png', alt: 'DELLA Mini Downlight DM30', title: 'DELLA — DM30 Series' },
      ]}
    />
  </section>

  <!-- Beam spread chart -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <BeamSpreadTable />
  </section>

  <!-- CCT guide embed -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <CctGuide />
  </section>

  <!-- Related reading -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <h2 class="text-2xl font-bold dark:text-white">Downlight &amp; OEM Resources</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/blog/oem-led-lighting-manufacturer-6-step-sourcing-checklist/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">OEM LED Lighting: 6-Step Sourcing Checklist →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >How to vet a factory and lock MOQ, lead time and QC in writing.</span
        >
      </a>
      <a
        href="/blog/custom-led-track-lighting-what-you-can-customize-moq-lead-time/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">Custom LED Lighting: MOQ &amp; Lead Time →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >Customize CCT, CRI, beam and dimming across our downlight families.</span
        >
      </a>
      <a
        href="/blog/how-to-choose-led-track-lighting-manufacturer-2026/"
        class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="font-semibold text-primary">How to Choose a Lighting Manufacturer →</span>
        <span class="mt-1 block text-sm text-muted dark:text-slate-400"
          >Factory vs trading desk, certification and QC checklist.</span
        >
      </a>
    </div>
  </section>

  <!-- RFQ -->
  <section id="get-quote" class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <QuoteForm product="LED Downlights (ELLA)" title="Request Downlight Quote" />
  </section>
</Layout>
