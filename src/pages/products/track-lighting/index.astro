---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import CctGuide from '~/components/CctGuide.astro';
import BeamSpreadTable from '~/components/BeamSpreadTable.astro';

const metadata = {
  title: 'LED Track Lighting Manufacturer & Supplier',
  description:
    'Track lighting manufacturer producing LED track systems for retail, museums and commercial spaces. OEM/ODM available, ETL/CE/ISO certified factory since 2011.',
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://astrowindwopress.vercel.app/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Track Lighting',
      item: 'https://astrowindwopress.vercel.app/products/track-lighting',
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <Content
    tagline="Products"
    title="LED Track Lighting Manufacturer"
    subtitle="Complete track lighting systems for retail, hospitality, museums, and commercial spaces"
    items={[
      {
        title: 'VEGA Track Light System',
        description:
          'Versatile track light series with multiple beam angles and wattages. Ideal for retail, galleries, and general commercial lighting.',
      },
      {
        title: 'OVEGA Track Light System',
        description:
          'Premium track light system with advanced thermal management and high CRI options. Suitable for high-end retail and museum applications.',
      },
      {
        title: 'IMAX Track Light System',
        description:
          'High-output track lighting for spaces requiring higher illumination levels. Excellent for commercial and industrial applications.',
      },
      {
        title: 'FLEX Track Light System',
        description:
          'Flexible track light system with adjustable heads and multiple mounting options. Perfect for accent and display lighting.',
      },
    ]}
    image={{
      src: '~/assets/images/products/prod-ovega-web-01.jpg',
      alt: 'OVEGA Track Light System by ENCORE',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Professional Track Lighting Solutions
      </h3>
      ETL, CE, and SAA certified track lighting systems for global projects.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our track lighting collection</p>
    <ProductGallery
      images={[
        { src: '/images/products/prod-ovega-web-01.jpg', alt: 'OVEGA Track Light', title: 'OVEGA Track Light' },
        {
          src: '/images/products/prod-ovega-web-02.jpg',
          alt: 'OVEGA Track Light Side View',
          title: 'OVEGA — Side View',
        },
        { src: '/images/products/prod-ovega-web-03.jpg', alt: 'OVEGA Track Light Detail', title: 'OVEGA — Detail' },
        {
          src: '/images/products/prod-ovega-web-04.jpg',
          alt: 'OVEGA Track Light Installation',
          title: 'OVEGA — Installation',
        },
        { src: '/images/products/prod-vega-s.jpg', alt: 'VEGA Track Light', title: 'VEGA Track Light' },
        { src: '/images/products/prod-vega-standard.jpg', alt: 'VEGA Standard Track Light', title: 'VEGA — Standard' },
        {
          src: '/images/products/prod-vega-projector.jpg',
          alt: 'VEGA Projector Track Light',
          title: 'VEGA — Projector',
        },
        { src: '/images/products/prod-vega-zoomable.jpg', alt: 'VEGA Zoomable Track Light', title: 'VEGA — Zoomable' },
        { src: '/images/products/prod-flex-web-01.jpg', alt: 'FLEX Track Light', title: 'FLEX Track Light' },
        { src: '/images/products/prod-flex-web-02.jpg', alt: 'FLEX Track Light Angle', title: 'FLEX — Angle View' },
        { src: '/images/products/prod-flex-web-03.jpg', alt: 'FLEX Track Light Detail', title: 'FLEX — Detail' },
        {
          src: '/images/products/prod-flex-web-04.jpg',
          alt: 'FLEX Track Light Application',
          title: 'FLEX — Application',
        },
        { src: '/images/products/prod-imax-standard.jpg', alt: 'IMAX Track Light', title: 'IMAX Track Light' },
        { src: '/images/products/prod-imax-white.png', alt: 'IMAX Track Light White', title: 'IMAX — White Series' },
        {
          src: '/images/products/prod-imax-projector.jpg',
          alt: 'IMAX Projector Track Light',
          title: 'IMAX — Projector',
        },
        { src: '/images/products/prod-imax-zoomable.jpg', alt: 'IMAX Zoomable Track Light', title: 'IMAX — Zoomable' },
      ]}
    />
  </section>

  <Features2
    title="Track Lighting Applications"
    columns={3}
    items={[
      {
        title: 'Retail Stores',
        description: 'Highlight merchandise and create inviting shopping environments with precise beam control.',
        icon: 'tabler:shopping-bag',
      },
      {
        title: 'Museums & Galleries',
        description: 'Protect artifacts with low-heat LED track lights while achieving perfect color rendering.',
        icon: 'tabler:building',
      },
      {
        title: 'Hotels & Hospitality',
        description: 'Create ambient and accent lighting zones in lobbies, restaurants, and guest areas.',
        icon: 'tabler:building',
      },
      {
        title: 'Commercial Offices',
        description: 'Flexible task and ambient lighting for modern workspace environments.',
        icon: 'tabler:building-community',
      },
      {
        title: 'Showrooms',
        description: 'Adaptable lighting that can be reconfigured as displays change.',
        icon: 'tabler:frame',
      },
      {
        title: 'Residential',
        description: 'Sleek, minimal track lighting for contemporary home interiors.',
        icon: 'tabler:home',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Beam Angle Tool Promo -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <div
      class="flex flex-col items-center gap-6 rounded-2xl border border-primary/20 bg-primary/5 p-8 text-center md:flex-row md:justify-between md:text-left"
    >
      <div>
        <h2 class="text-2xl font-bold dark:text-white">Need to work out the beam spread?</h2>
        <p class="mt-2 max-w-xl text-muted dark:text-slate-400">
          Use our free beam angle calculator to convert beam angle, mounting distance and spot size for any fixture.
        </p>
      </div>
      <a href="/beam-angle-calculator" class="btn btn-primary shrink-0">Open Beam Angle Calculator</a>
    </div>
  </section>

  <!-- Beam spread chart -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <BeamSpreadTable />
  </section>

  <!-- CCT guide embed -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <CctGuide />
  </section>

  <!-- RFQ -->
  <section id="get-quote" class="mx-auto max-w-7xl px-4 py-12 md:px-6 lg:py-16">
    <QuoteForm product="Track Lighting (VEGA)" title="Request Track Lighting Quote" />
  </section>
</Layout>
