# ============================================================
# Beamangle 环境变量配置参考（复制为 .env 并填入真实值）
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会入库
# ============================================================

# ---------- API Keys ----------
# TabAPI（SEO/域名情报 API）
TABAPI_API_KEY=sk_your_tabapi_key_here

# APIMart（AI 生图 API）
APIMART_API_KEY=sk_your_apimart_key_here

# Pexels（免版税图片搜索 API，用于博客配图，可替代 AI 生图）
PEXELS_API_KEY=your_pexels_key_here

# ---------- Clash 代理配置（端口 7897）----------
# ⚠️ 重要：代理必须在【发起请求的那台机器】上运行（你本机跑 Clash）。
# CI / 构建机没有你的 Clash，无法替你访问需要代理的服务。
#
# 💡 实测结论：
#   - TabAPI（SEO 分析）直连即可访问，【无需代理】
#   - APIMart（AI 生图 api.apimart.ai）被墙，【仅在你本机跑 Clash 才能访问】
#
# 所以：本地跑 APIMart 生图脚本时才需要下面的代理；TabAPI 类脚本可把代理留空。
# 💡 Pexels（api.pexels.com）直连即可访问，无需代理。
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
ALL_PROXY=http://127.0.0.1:7897

# 各脚本独立代理变量（默认已内置 http://127.0.0.1:7897，无需修改）
# 如需关闭某服务代理，置空即可，例如：
#   TABAPI_PROXY=
#   APIMART_PROXY=
TABAPI_PROXY=http://127.0.0.1:7897
APIMART_PROXY=http://127.0.0.1:7897
