# 构建镜像：为 Release / 打包流水线预装 zip 工具与项目依赖
FROM node:22-bookworm-slim

# 预装 zip 打包工具
RUN apt-get update \
    && apt-get install -y --no-install-recommends zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 预装依赖（package.json / package-lock.json 变化时自动重建该缓存层）
COPY package.json package-lock.json ./
RUN npm ci

# 复制项目源码
COPY . .
